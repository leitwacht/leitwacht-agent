// leitwacht-agent — public, MPL-2.0-licensed agent data plane.
//
// This module holds the enforcement primitives the agent uses on every
// runner host: eBPF programs + nftables glue + the in-netns DNS proxy
// (`agentcore/enforcer`), the container-lifecycle watcher
// (`agentcore/watcher`), the policy cache + plain-Go violation/advisory
// types, the leitwacht-initc helper binary (`agentcore/cmd`), and the
// CE daemon (`ce/`) — a YAML-driven, backend-free build with NDJSON /
// Prometheus / webhook sinks.
//
// EE consumers import this module via Go's standard dependency
// resolution and provide their own gRPC sinks.
//
// See LICENSE (MPL-2.0) and NOTICE.
module gitlab.com/leitwacht/leitwacht-agent

go 1.27.3

require (
	github.com/cilium/ebpf v0.21.0
	github.com/containerd/containerd/api v1.11.0
